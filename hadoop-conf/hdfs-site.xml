<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>

  <property>
    <name>dfs.replication</name>
    <value>2</value>
    <description>Two copies of every block across three datanodes: survives one node dying, which is the demo.</description>
  </property>

  <property>
    <name>dfs.namenode.name.dir</name>
    <value>/hadoop/dfs/name</value>
  </property>

  <property>
    <name>dfs.datanode.data.dir</name>
    <value>/hadoop/dfs/data</value>
  </property>

  <property>
    <name>dfs.blocksize</name>
    <value>134217728</value>
    <description>128 MB. Telemetry files are sized well above this so a single file splits across nodes.</description>
  </property>

  <property>
    <name>dfs.namenode.http-address</name>
    <value>0.0.0.0:9870</value>
  </property>

  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>

  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>true</value>
  </property>

  <property>
    <name>dfs.datanode.use.datanode.hostname</name>
    <value>true</value>
  </property>

</configuration>
